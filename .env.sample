# Required
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
SLACK_BOT_TOKEN=xoxb-YOUR_BOT_TOKEN
SLACK_APP_TOKEN=xapp-YOUR_APP_TOKEN

# Integrations. Each can also be read from a dotfile in $HOME
# (~/.teamcity_token, ~/.youtrack_token, ~/.gitlab_token, ~/.grafana_token) when not set here.
# TEAMCITY_TOKEN=YOUR_TEAMCITY_TOKEN
# YOUTRACK_API_TOKEN=YOUR_YOUTRACK_TOKEN
# GITLAB_TOKEN=YOUR_GITLAB_READ_API_TOKEN
# GRAFANA_TOKEN=YOUR_GRAFANA_VIEWER_SERVICE_ACCOUNT_TOKEN

# Optional, Slack user token (xoxp-...) so the "Create YouTrack Ticket" shortcut
# can read DM history the bot cannot see. Also read from ~/.slack_user_token.
# SLACK_USER_TOKEN=xoxp-YOUR_USER_TOKEN

# Optional, path to the deployment config (default: fenix.config.json).
# FENIX_CONFIG=fenix.config.json

# Optional, bearer token for the MCP endpoint used by Claude Code (generate with: openssl rand -hex 32).
# FENIX_MCP_TOKEN=YOUR_LONG_RANDOM_TOKEN
